{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true,
      "cwd": "frontend"
    },
    {
      "name": "backend",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "manage.py",
        "runserver",
        "8001"
      ],
      "port": 8001,
      "cwd": "backend"
    },
    {
      "name": "employee-web-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "D:/Projects/Employee-Web-App/Employee-Web-App",
        "run",
        "dev",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    }
  ]
}
