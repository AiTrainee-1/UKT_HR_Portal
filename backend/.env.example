# Copy to .env and adjust

DB_HOST=host
DB_PORT=5432
DB_NAME=db_name
DB_USER=postgres
DB_PASSWORD=password

# Only the super-admin bootstrap account lives in .env -every other
# HR-portal login (HR, MD, Directors, EA, EDP, ...) is created and managed
# from Account Management inside the portal (Admin-only).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

JWT_SECRET=uk-textile-jwt-secret-change-in-production
DJANGO_SECRET_KEY=django-dev-secret-change-in-production

DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend dev servers (Vite)
# Browser origins allowed to call this API. Frontends only -a backend host
# belongs in ALLOWED_HOSTS, not here. No trailing slashes.
#   https://hrms.uktextiles.in  HR portal
#   https://emp.uktextiles.in   Employee web app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:23805,http://127.0.0.1:5173

# Biometric -eSSL e2008 (ZK/ICLOCK protocol, pulled by server via pyzk)
# Find the device IP: Main Menu → COMM. → Ethernet → IP Address
BIOMETRIC_DEVICE_IP=192.168.0.XXX
BIOMETRIC_DEVICE_PORT=4370
BIOMETRIC_DEVICE_PASSWORD=0

# HTTP-push API key (not used by eSSL e2008 pull approach -reserved for future)
BIOMETRIC_API_KEY=change-this-to-a-strong-random-key

# Co HRMS Portal -shared secret its backend sends in X-Portal-Key when
# pulling employees/attendance from the read-only /api/co-portal/* endpoints.
# Must exactly match MAIN_HRMS_PORTAL_KEY in the Co Portal's own .env.
CO_PORTAL_API_KEY=change-this-to-a-strong-random-key

# WhatsApp via WAClient (Web API): app.waclient.com -> link your number to an instance
# (QR code), then copy the Instance ID and Access Token. Blank disables WhatsApp sending.
WACLIENT_INSTANCE_ID=
WACLIENT_ACCESS_TOKEN=
# WHATSAPP_SEND_DELAY_SECONDS=2
# A development machine (DEBUG=true, or running under runserver) NEVER sends WhatsApp, so a laptop wired to the
# live database and live number can't message employees. Leave blank for that; set true/false to force it.
# WHATSAPP_ALLOW_SENDING=
# Burst guard for the automatic attendance alerts (alerts over a limit are skipped, not queued; 0 = no limit).
# WHATSAPP_ALERTS_MAX_PER_RUN=10
# WHATSAPP_ALERTS_MAX_PER_HOUR=60
# WHATSAPP_ALERTS_MAX_PER_DAY=300
# BACKEND_PUBLIC_URL=https://api.example.com
# Where the Employee Web App lives; approval messages then carry a "View request" link.
# EMPLOYEE_PORTAL_URL=https://employee.example.com
# Approval / visitor / gate messages go from a background worker (set false to send inline).
# WHATSAPP_ASYNC_SEND=true
# WHATSAPP_MIN_SEND_GAP_SECONDS=1

# SMS one-time codes via 2Factor.in (login, forgot password, account activation). WhatsApp stays the default channel; HR
# picks SMS on the SMS Control page once this is filled in. Setup guide: twofactor-sms-otp-integration.md. These stay in
# this file ONLY: they are never stored in the database, shown in the portal or written to a log.
# The values below are PLACEHOLDERS: while one still looks like a placeholder (your_..., demo..., xxx..., changeme...,
# <...>, ..._here) the system treats SMS as NOT configured and can never send.
# One approved DLT template: name UKT_HRMS_OTP, sender UKTHRM, text "XXXX is your UK Textiles HRMS OTP. Official message
# from UK Textiles. Do not share it with anyone." (2Factor puts our one-time code in the XXXX place.)
# API key: 2Factor panel -> API Docs / API Key. WARNING: 2Factor's API carries the key in the URL, so keep it secret
# (this system hides it from every log, error and page).
TWOFACTOR_API_KEY=your_2factor_api_key_here
# The template NAME as shown in the 2Factor panel (not an ID).
TWOFACTOR_TEMPLATE_NAME=UKT_HRMS_OTP
# The 6-letter DLT sender header (informational: 2Factor takes the sender from the template).
TWOFACTOR_SENDER_ID=UKTHRM
# 2Factor's API address. https only (plain http is accepted for localhost only: a fake server of a test).
TWOFACTOR_API_BASE=https://2factor.in/API/V1
# The country the mobile numbers belong to (numbers are checked against it before anything is sent). Default: the
# WhatsApp default country code.
# SMS_COUNTRY_CODE=91
# A development machine (DEBUG=true, or running under runserver) NEVER sends SMS, so a laptop wired to the live
# database and live 2Factor account can't text employees. Leave blank for that; set true/false to force it.
SMS_ALLOW_SENDING=

# MD portal AI assistant (Google Gemini). Create a key in Google AI Studio (the free tier is enough to start), paste it
# here and restart the backend. The key lives ONLY here: it is never stored in the database or shown in the portal.
# Switch the assistant on/off, pick the model and privacy mode in Account Management -> MD profile.
# The free tier may use what is sent to improve Google's products: names are replaced by codes before sending, but enable
# billing on the Google project before relying on it with real payroll data. Voice needs HTTPS (or localhost).
GEMINI_API_KEY=
# Only for tests / a proxy: where the Gemini API is (default https://generativelanguage.googleapis.com/v1beta).
# GEMINI_API_BASE_URL=

# Rate limiting (login, OTP, gate): how many proxies sit in front of Django. The client IP is taken from the LAST
# X-Forwarded-For hop (the one the nearest proxy added). Railway alone = 1 (default); add 1 for each extra proxy such as
# Cloudflare; 0 when Django is reached directly. Wrong values make every caller share one counter or let spoofing through.
# NUM_PROXIES=1
