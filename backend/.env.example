# Copy to .env and adjust

DB_HOST=host
DB_PORT=5432
DB_NAME=db_name
DB_USER=postgres
DB_PASSWORD=password

# Only the super-admin bootstrap account lives in .env -every other
# HR-portal login (HR, MD, Directors, EA, EDP, ...) is created and managed
# from Account Management inside the portal (Admin-only).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

JWT_SECRET=uk-textile-jwt-secret-change-in-production
DJANGO_SECRET_KEY=django-dev-secret-change-in-production

DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend dev servers (Vite)
# Browser origins allowed to call this API. Frontends only -a backend host
# belongs in ALLOWED_HOSTS, not here. No trailing slashes.
#   https://hrms.uktextiles.in  HR portal
#   https://emp.uktextiles.in   Employee web app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:23805,http://127.0.0.1:5173

# Biometric -eSSL e2008 (ZK/ICLOCK protocol, pulled by server via pyzk)
# Find the device IP: Main Menu → COMM. → Ethernet → IP Address
BIOMETRIC_DEVICE_IP=192.168.0.XXX
BIOMETRIC_DEVICE_PORT=4370
BIOMETRIC_DEVICE_PASSWORD=0

# HTTP-push API key (not used by eSSL e2008 pull approach -reserved for future)
BIOMETRIC_API_KEY=change-this-to-a-strong-random-key

# Co HRMS Portal -shared secret its backend sends in X-Portal-Key when
# pulling employees/attendance from the read-only /api/co-portal/* endpoints.
# Must exactly match MAIN_HRMS_PORTAL_KEY in the Co Portal's own .env.
CO_PORTAL_API_KEY=change-this-to-a-strong-random-key

# WhatsApp via WAClient (Web API): app.waclient.com -> link your number to an instance
# (QR code), then copy the Instance ID and Access Token. Blank disables WhatsApp sending.
WACLIENT_INSTANCE_ID=
WACLIENT_ACCESS_TOKEN=
# WHATSAPP_SEND_DELAY_SECONDS=2
# A development machine (DEBUG=true, or running under runserver) NEVER sends WhatsApp, so a laptop wired to the
# live database and live number can't message employees. Leave blank for that; set true/false to force it.
# WHATSAPP_ALLOW_SENDING=
# Burst guard for the automatic attendance alerts (alerts over a limit are skipped, not queued; 0 = no limit).
# WHATSAPP_ALERTS_MAX_PER_RUN=10
# WHATSAPP_ALERTS_MAX_PER_HOUR=60
# WHATSAPP_ALERTS_MAX_PER_DAY=300
# BACKEND_PUBLIC_URL=https://api.example.com
# Where the Employee Web App lives; approval messages then carry a "View request" link.
# EMPLOYEE_PORTAL_URL=https://employee.example.com
# Approval / visitor / gate messages go from a background worker (set false to send inline).
# WHATSAPP_ASYNC_SEND=true
# WHATSAPP_MIN_SEND_GAP_SECONDS=1
