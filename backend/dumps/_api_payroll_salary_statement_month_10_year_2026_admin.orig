asic":11000.0,"total":22000.0,"present":25.0,"cl":0.0,"lop":2.0,"hd":2.0,"totalDays":25.0,"petrol":0.0,"othersAllow":11000.0,"eSalary":20370.37,"advance":0.0,"esi":0.0,"pf":0.0,"tds":0.0,"others":0.0,"lopAmount":1629.63,"totalDeduction":0.0,"net":20370.37,"remarks":"","sno":140}},{"payrollId":24033,"employeeId":94,"sno":141,"status":"pending","values":{"code":"2682","name":"JEEVA SEKAR SEKAR","designation":"DRIVER","basic":11000.0,"total":22000.0,"present":25.5,"cl":0.0,"lop":1.5,"hd":3.0,"totalDays":25.5,"petrol":0.0,"othersAllow":11000.0,"eSalary":20777.78,"advance":0.0,"esi":0.0,"pf":0.0,"tds":0.0,"others":0.0,"lopAmount":1222.22,"totalDeduction":0.0,"net":20777.78,"remarks":"","sno":141}},{"payrollId":24027,"employeeId":39,"sno":142,"status":"pending","values":{"code":"6395","name":"SAKTHIVEL MURUGAIYAN","designation":"DRIVER","basic":11000.0,"total":22000.0,"present":25.0,"cl":0.0,"lop":2.0,"hd":0.0,"totalDays":25.0,"petrol":0.0,"othersAllow":11000.0,"eSalary":20370.37,"advance":0.0,"esi":0.0,"pf":0.0,"tds":0.0,"others":0.0,"lopAmount":1629.63,"totalDeduction":0.0,"net":20370.37,"remarks":"","sno":142}}],"subtotal":{"payrollId":null,"employeeId":null,"sno":null,"status":null,"values":{"sno":null,"code":null,"name":"Sub total","designation":null,"basic":33000.0,"total":66000.0,"present":75.5,"cl":0.0,"lop":5.5,"hd":5.0,"totalDays":75.5,"petrol":0.0,"othersAllow":33000.0,"eSalary":61518.52,"advance":0.0,"esi":0.0,"pf":0.0,"tds":0.0,"others":0.0,"lopAmount":4481.48,"totalDeduction":0.0,"net":61518.52,"remarks":null}}}],"total":{"payrollId":null,"employeeId":null,"sno":null,"status":null,"values":{"sno":null,"code":null,"name":"Grand total","designation":null,"basic":2499777.0,"total":4999554.0,"present":2895.75,"cl":8.0,"lop":930.25,"hd":303.0,"totalDays":2903.75,"petrol":4600.0,"othersAllow":2495177.0,"eSalary":3764679.34,"advance":0.0,"esi":3633.33,"pf":5911.11,"tds":0.0,"others":9572.28,"lopAmount":1235541.33,"totalDeduction":19116.72,"net":3745562.62,"remarks":null}},"counts":{"employees":142,"departments":26,"paid":4,"pending":138},"notes":["Basic is the first salary-split portion (Basic + DA + Retaining Allowance); with no split recorded it is 50% of the salary. PTRL is the Petrol allowance and Others Allow the rest of the second portion, so Basic + PTRL + Others Allow = Total.","Total is the monthly salary. E salary is the salary earned for the days paid (Total x Total Days / days of the month) plus any overtime pay and HR bonus. The days of the month are every day but Sundays, company holidays included (27 in a 31-day month with 4 Sundays), so declaring a holiday never raises the per-day salary; a payroll generated before 4 Nov 2026 divided by the working days instead.","Present is the days paid as worked or as a company holiday (a half day counts 0.5; a working day HR marked as a paid holiday counts 1), without Casual Leave; CL is the approved Casual Leave days (a half-day CL counts 0.5); Total Days = Present + CL; LOP = days of the month - Total Days; HD is the number of half-shift days.","Advance is the advance recovered from this month's pay (an advance balance still owed is not part of this month's pay and is not listed).","ESI and PF are deducted only from Co Emp employees (Employees > Co Emp), by the rules of Settings > PF & ESI, from Basic + DA + Retaining Allowance. TDS is deducted only from employees on the TDS list: the TDS percentage set for them of the pay earned (it is 0 for everybody else).","Others is the late deduction plus any deduction HR added; Total Deduction = ESI + PF + TDS + Advance + Others; NET = E salary - Total Deduction.","Lop& PSAmt = Total - E salary: the pay lost to LOP. It is shown for information and is not part of Total Deduction."]}