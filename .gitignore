# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local

# Python
.venv/
.venv*/
__pycache__/
*.py[cod]
*.egg-info/

# IDEs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Logs & OS
*.log
logs/
backend/logs/
.DS_Store
Thumbs.db

# Secret / API key files -never commit these
apikey.txt
*.key
secrets.txt

# Django
backend/db.sqlite3
backend/staticfiles/
backend/media/

# Backup/restore runtime artifacts -real DB dumps and employee documents
# pass through these; never belongs in git. backup_staging/ is where
# uploaded restore files land (backup_service.py); backups/ is the default
# scheduled/manual backup output dir; media_pre_restore_*/ is the automatic
# safety snapshot backup_views.py takes before every restore.
backend/backup_staging/
backend/backups/
backend/media_pre_restore_*/

